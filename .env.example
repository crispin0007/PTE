# Copy to .env (scripts/selfhost-init.sh does it and fills in the secrets).
# Every setting is explained in docs/SELF_HOST.md.

# Where people open the app, and where the app reaches the API.
PUBLIC_WEB_URL=http://localhost:8080
PUBLIC_API_URL=http://localhost:3000
# For HTTPS with --profile https: the two domain names (no https://).
WEB_DOMAIN=
API_DOMAIN=

# Secrets: long random strings. Never commit .env.
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
SPEECH_TOKEN=

# The first admins (comma-separated emails).
ADMIN_EMAILS=
# Shown on the privacy page as the address for questions about data and account deletion.
CONTACT_EMAIL=

# One coaching centre? Its name; everyone who signs in joins it. Leave empty for many institutes.
SINGLE_INSTITUTE_NAME=
# With many institutes: who may create one (anyone or admin).
INSTITUTE_CREATION=anyone

# Sign-in emails. Without SMTP_URL, links are printed in the API log (docker compose logs api).
SMTP_URL=
MAIL_FROM=openpte <no-reply@example.com>

# Optional Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 1 shows questions still waiting for two human reviews (the bundled bank is still in review).
INCLUDE_UNREVIEWED=1
# Server speech scores per learner per day, and the Whisper model size.
SPEECH_DAILY_LIMIT=30
WHISPER_MODEL=small.en
# Pronunciation scoring by sound (on), or off to save about 1.5 GB of memory. CPU threads for both.
PRONUNCIATION=on
SPEECH_THREADS=2
# Export a copy of the phoneme model (about 330 MB) that browsers run on the learner's device when
# the server cannot score, such as for learners who are not signed in. The one-time export needs
# about 4 GB of free memory; set off on a small server.
BROWSER_MODEL=on
